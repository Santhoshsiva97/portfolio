# Contact form delivery. Copy to .env.local (never commit real keys) and set ONE provider.
# With neither set, messages are logged to the server console in development
# and the form shows an "email me directly" error in production.

# Option A — Resend (recommended): https://resend.com → API Keys
RESEND_API_KEY=
# Where enquiries are delivered (defaults to the email in content/resume.json)
CONTACT_TO_EMAIL=
# Sender. Leave empty to use "Portfolio <onboarding@resend.dev>" until your domain is verified in Resend.
CONTACT_FROM_EMAIL=

# Option B — Formspree: https://formspree.io → New form → the ID in https://formspree.io/f/<ID>
FORMSPREE_FORM_ID=
